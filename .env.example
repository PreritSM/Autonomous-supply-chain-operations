# Copy to .env and fill in. .env is gitignored.

# --- Backend seam (Phase 0) ---
# Selects the concrete backend behind each MCP server. Postgres/local_fs/dbt
# is the default demo path (Phase 1); the Databricks-side options are Phase 2.
WAREHOUSE_BACKEND=postgres        # postgres | databricks
LANDING_ZONE_BACKEND=local_fs     # local_fs | uc_volume
PIPELINE_BACKEND=dbt              # dbt | databricks

# --- Postgres warehouse (docker-compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
POSTGRES_DB=supply_pipeline

# dbt target schema (staging/intermediate/marts land here; bi has its own schema)
DBT_SCHEMA=analytics

# --- Read-only Power BI user (Build Spec §14.3) ---
POWERBI_READER_PASSWORD=change-me

# --- LLM (NVIDIA API Catalog / NIM playground, GLM 5.2; used by all four agents) ---
# Accessed via langchain_nvidia_ai_endpoints.ChatNVIDIA
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.2
